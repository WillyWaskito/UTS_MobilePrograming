<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">
    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/topLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/top_label"
            android:textColor="@color/purple"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:id="@+id/menuPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_card"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡"
                android:textSize="68sp"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/menu_title"
                android:textColor="@color/purple_dark"
                android:textStyle="bold"
                android:textSize="29sp"
                android:gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/menu_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/bestScoreText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/best_score_none"
                android:textColor="@color/purple"
                android:textStyle="bold"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/startButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="@string/btn_start"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_purple_button"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/aboutButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/btn_about"
                android:textAllCaps="false"
                android:textColor="@color/purple_dark"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_outline_button"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/helpButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/btn_help"
                android:textAllCaps="false"
                android:textColor="@color/purple_dark"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_outline_button"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/gamePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_score"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"/>
                    <TextView
                        android:id="@+id/scoreText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_dark"/>
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="44dp"
                    android:background="#E6E8FF"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="end">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_attempts"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"/>
                    <TextView
                        android:id="@+id/attemptText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:textColor="@color/purple_dark"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_card"
                android:padding="22dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯"
                    android:textSize="42sp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/game_question"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    android:layout_marginTop="8dp"/>
                <TextView
                    android:id="@+id/rangeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/game_range_default"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="18dp"/>
                <EditText
                    android:id="@+id/guessInput"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:hint="@string/hint_input"
                    android:inputType="number"
                    android:maxLength="3"
                    android:singleLine="true"
                    android:selectAllOnFocus="true"
                    android:gravity="center"
                    android:textSize="23sp"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_input"
                    android:padding="10dp"
                    android:importantForAutofill="no"/>
                <Button
                    android:id="@+id/guessButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="@string/btn_guess"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_purple_button"
                    android:stateListAnimator="@null"/>
                <TextView
                    android:id="@+id/feedbackText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/feedback_start"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="18dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/restartButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/btn_restart"
                android:textAllCaps="false"
                android:textColor="@color/purple_dark"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_outline_button"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/homeButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/btn_home"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/background"/>
        </LinearLayout>

        <TextView
            android:id="@+id/footerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/footer"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="18dp"/>
    </LinearLayout>
</ScrollView>
